				OutputFile="$(OutDir)\Quake2SSE.exe" ProgramDatabaseFile="$(IntDir)\$(TargetName).pdb" ImportLibrary="$(IntDir)\$(TargetName).lib" GenerateMapFile="true" MapFileName="$(IntDir)\$(TargetName).map"
